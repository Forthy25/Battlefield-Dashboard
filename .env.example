# Server Configuration
PORT=3000
IP=127.0.0.1

# Database
# Example for local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/bf6-dashboard
# Or Atlas Cloud:
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=ProjectName

# Security - MUST be set! Use a secure, random string
SESSION_SECRET=your_super_secret_key_change_this_in_production

# CORS - Allowed origins for cross-origin requests
CORS_ORIGIN=http://localhost:3000
